 types body"}, "settings_content_fileTypes_source": {"message": "Forr\u00e1sk\u00f3d", "description": "File types body"}, "settings_content_credits_inspiredBy": {"message": "Ezt a kieg\u00e9sz\u00edt\u0151t a <a href=\"http://extendopera.org/linked-content/link-alert\" target=\"_blank\">LinkAlert</a> felhaszn\u00e1l\u00f3i szkript ihlette.", "description": "Credits body"}, "settings_content_protocols_secure": {"message": "HTTPS kapcsolat (biztons\u00e1gos)", "description": "Protocols body"}, "settings_content_preferences_blacklistOn": {"message": "A b\u0151v\u00edtm\u00e9ny letilt\u00e1sa a k\u00f6vetkez\u0151 oldalakon:", "description": "Preferences body"}, "settings_content_preferences_noTitle": {"message": "A title attrib\u00fatum elt\u00e1vol\u00edt\u00e1sa a linkekr\u0151l", "description": "Preferences body"}, "settings_content_license_header": {"message": "Licenc", "description": "License header"}, "settings_content_credits_thanks": {"message": "K\u00f6sz\u00f6net mindenkinek, aki hozz\u00e1j\u00e1rult a b\u0151v\u00edtm\u00e9nyhez. <em>(A r\u00e9szleteket l\u00e1sd a V\u00e1ltoz\u00e1slist\u00e1ban!)", "description": "Credits body"}, "settings_content_performance_header": {"message": "Teljes\u00edtm\u00e9nybeli probl\u00e9m\u00e1k", "description": "Performance issues header"}, "settings_content_permissions_header": {"message": "Enged\u00e9lyek", "description": "Permissions header"}, "settings_content_attributes_onContextMenu": {"message": "Saj\u00e1t helyi men\u00fcvel rendelkez\u0151 link", "description": "Attributes body"}, "settings_content_preferences_header": {"message": "Be\u00e1ll\u00edt\u00e1sok", "description": "Preferences header"}, "settings_content_notes_header": {"message": "Megjegyz\u00e9sek", "description": "Notes header"}, "settings_content_fileTypes_video": {"message": "Vide\u00f3", "description": "File types body"}, "settings_content_notes_howItWorks": {"message": "A Link Alert csak a forr\u00e1sk\u00f3dban megjelen\u0151 linkeket vizsg\u00e1lja, nem k\u00fcld semmilyen k\u00e9r\u00e9st a linkelt weboldal ir\u00e1ny\u00e1ba. El\u0151fordulhat, hogy egy link \u00fagy hivatkozik p\u00e9ld\u00e1ul egy PDF f\u00e1jlra, hogy ez a linkb\u0151l egy\u00e1ltal\u00e1n nem der\u00fcl ki. Ezzel a m\u00f3dszerrel ezt nem lehet ellen\u0151rizni, ez\u00e9rt ilyen esetekben a Link Alert nem fog jelezni.", "description": "Notes body"}, "settings_content_url_hash": {"message": "Oldalon bel\u00fclre mutat\u00f3 link", "description": "URL body"}, "settings_content_protocols_header": {"message": "Protokolok", "description": "Protocols header"}, "settings_content_contact_email": {"message": "<a href=\"mailto:nekomajin42@gmail.com\">Email</a>", "description": "Contact body"}, "settings_content_permissions_data": {"message": "A Link Alert az\u00e9rt k\u00e9r hozz\u00e1f\u00e9r\u00e9st a webhelyekhez, hogy elemezni tudja a weblapokon megjelen\u0151 linkeket.", "description": "Permissions body"}, "settings_content_warning_notResponsible": {"message": "Ez a b\u0151v\u00edtm\u00e9ny nem az Opera Software ASA term\u00e9ke. A c\u00e9g nem felel\u0151s a b\u0151v\u00edtm\u00e9ny esetleges hib\u00e1i\u00e9rt.", "description": "Warning body"}, "settings_content_attributes_header": {"message": "Attrib\u00fatumok", "description": "Attributes header"}, "settings_content_attributes_onClick": {"message": "Eg\u00e9r kattint\u00e1st kezel\u0151 link", "description": "Attributes body"}, "settings_content_fileTypes_executable": {"message": "Futtathat\u00f3 f\u00e1jl", "description": "File types body"}, "settings_sidebar_menuitem_credits": {"message": "N\u00e9vjegy", "description": "Sidebar menu"}, "settings_content_notes_operaPolicy": {"message": "Az Opera ir\u00e1nyelvei szerint a kieg\u00e9sz\u00edt\u0151k nem m\u0171k\u00f6dnek a b\u00f6ng\u00e9sz\u0151 bels\u0151 lapjain, p\u00e9ld\u00e1ul a Be\u00e1ll\u00edt\u00e1sokban, az El\u0151zm\u00e9nyekben vagy ezen az oldalon.", "description": "Notes body"}, "settings_content_protocols_magnet": {"message": "M\u00e1gnes link", "description": "Protocols body"}, "settings_content_howToUse_reload": {"message": "A b\u0151v\u00edtm\u00e9ny telep\u00edt\u00e9se \u00e9s a be\u00e1ll\u00edt\u00e1sok m\u00f3dos\u00edt\u00e1sa ut\u00e1n friss\u00edtened kell a megnyitott lapokat.", "description": "How to use body"}, "settings_content_howToUse_smartPosition": {"message": "Ha enged\u00e9lyezed az \"okos poz\u00edcion\u00e1l\u00e1st\", a b\u0151v\u00edtm\u00e9ny ki fogja sz\u00e1molni, hogy az ikonok elf\u00e9rnek-e az eg\u00e9rkurzor jobb oldal\u00e1n. Ha nem f\u00e9rnek el, akkor bal oldalra teszi \u0151ket. Ha kikapcsolod ezt az opci\u00f3t, akkor az ikonok mindig a kurzor jobb oldal\u00e1n jelennek meg, de lehet, hogy kil\u00f3gnak a l\u00e1that\u00f3 tartom\u00e1nyb\u00f3l.", "description": "How to use body"}, "settings_content_protocols_feed": {"message": "H\u00edrcsatorna", "description": "Protocols body"}}